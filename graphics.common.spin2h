{Spin2_v46}
#include "terminal.common.spin2h"               ' for printf(), puts(), etc
#ifndef MAX_CONTEXTS
# define MAX_CONTEXTS 1
#endif

#ifndef MAX_FONTS
# define MAX_FONTS 1
#endif

CON

    ' display structure definitions
    struct cursor_s(...
        word x, y)


    ' display base config
    struct disp_setup_s(...
        long p_buffer, ...                      ' pointer to the display buffer
        long buffer_sz, ...                     ' buffer size (bytes)
        word width, height, ...                 ' screen dimensions (pixels)
        word stride)                            ' size of a line (bytes)

    ' display context
    struct disp_context_s(...
        long p_buffer, ...                      ' pointer to the context's buffer
        long buffer_sz, ...                     ' size of the buffer in bytes
        long fgcolor, ...
        long bgcolor, ...
        word stride, ...                        ' xxx is this really needed?
        word sx, sy, ...                        ' display area
        word ex, ey, ...
        byte rotation)

    ' font setup
    struct font_setup_s(...
        long p_ftable, ...                      ' pointer to font data/table
        word cursor_xmax, cursor_ymax, ...      ' pixel-level coordinate maximums
        byte glyph_w, glyph_h, ...              ' glyph dims
        byte rotation, ...                      ' rotation format of font glyph data
        byte char_min, char_max, ...            ' min and max ASCII values represented by font
        byte hspace, vspace, ...                ' pixel spacing between cols/rows
        byte xscale, yscale, ...                ' glyph scaling factors
        byte cell_w, cell_h, ...                ' character cell dims (glyph dims+spacing)
        byte cell_xmax, cell_ymax)              ' character cell-level coordinate maximums
        'xxx maybe putchar func pointer?


VAR

    { putchar() function pointer }
    long            putchar

    disp_setup_s    screen
    disp_context_s  ctx'[MAX_CONTEXTS]
    cursor_s        cursor
    font_setup_s    font[MAX_FONTS]

    { terminal i/o attributes }
    long            _char_attrs


PUB bgcolor(col)
' Set background color for subsequent drawing
    ctx.bgcolor := col


#ifndef GFX_DIRECT
PUB bitmap(p_bmap, xs, ys, w, h) | p_fb_end, src, dest, offs
' Copy a bitmap to the display buffer
'   p_bmap:     pointer to bitmap data
'   (xs, ys):   upper-left corner of bitmap
'   w:          width of bitmap, in pixels
'   h:          number of lines in bitmap
    w /= BPPDIV                                 ' for color depths less than 8bpp
    p_fb_end := (ctx.p_buffer+ctx.buffer_sz)-ctx.stride' calc ptr to start of last row of FB memory
    w := w <# ((ctx.ex-ctx.sx)+1)-xs            ' limit width to fit from here to context width
    xs *= BYTESPERPX
    src := p_bmap                               ' init working pointers
    dest := ctx.p_buffer                     '
    repeat
        ' calc offset from framebuffer and bitmap start,
        '   then copy the bitmap one line at a time,
        '   using the display's defined native word size
        offs := ( (ys * ctx.stride) + xs)
        dest += offs
        MEMMV_NATIVE(   dest <# p_fb_end, ...   ' protect against writing past the FB in RAM
                        src, ...
                        w)
        src += offs
        ys++                                    ' next row
    while (--h)                                 ' loop if there're more lines
#endif


PUB bitmap_1bpp(ptr_bmap, x, y, w, h) | bmbytes_ln, b, j, i, row, col
' Copy a 1-bpp bitmap to the display buffer
'   ptr_bmap: pointer to bitmap data
'   (x, y): upper-left corner of bitmap
'   w: width of bitmap, in pixels
'   h: height of bitmap, in pixels
    bmbytes_ln := (w + 7) / 8                   ' bytes per line of the bitmap
    b := 0

    repeat row from 0 to h-1
        repeat col from 0 to w-1
            if ( col & 7 )
                b <<= 1
            else
                b := byte[ptr_bmap][(row * bmbytes_ln) + (col / 8)]
            if ( b & $80 )
                plot(x + col, y, 1)
        y++


#ifndef GFX_DIRECT
PUB box(sx, sy, ex, ey, c, f=false) | x, y, w
' Draw a box
'   sx, sy: start coordinates
'   ex, ey: end coordinates
'   c:      box color
'   filled: flag to set whether to fill the box or not (default: no)
    DEBUG("[gfx] box(", udec_(sx), udec_(sy), udec_(ex), udec_(ey), ")")
    case f
        false:
            hline(sy, sx, ex-sx+1, c)           ' draw top edge
            hline(ey, sx, ex-sx+1, c)           ' draw bottom edge
            vline(sx, sy, ey-sy+1, c)           ' draw left edge
            vline(ex, sy, ey-sy+1, c)           ' draw right edge
        true:
# ifdef 1BPP
            repeat y from sy to ey
                repeat x from sx to ex
                    plot(x, y, c)
# else
            w := abs(ex-sx)+1               ' get fill width
            if ( ex < sx )                  ' swap sx and ex if ex is less
                sx, ex := ex, sx
            repeat y from sy to ey          ' fill each line of the box's region
                memfill(sx, y, c, w)
# endif
#endif

PUB tx = putchar
PUB char = putchar

PUB putchar32_0deg(ch) | bpr, lastbyte, p, last_glcol, last_glrow, char_wid, char_ht, rowbyte, bit, gl_row, gl_col
' Low-level character rendering routine
'   For font file definitions with these characteristics:
'   * 0 degrees rotation (portrait, top-down)
'   * each glyph word is a row of the glyph, e.g. for 5x8 'A':
'       %00100000
'       %01010000
'       %10001000
'       %10001000
'       %11111000
'       %10001000
'       %10001000
'       %00000000
'   * bit order can be normal (MSBit in each glyph word is left edge)
'       or reversed (MSBit in each glyph word is right edge; build with -DFNT_GLYPH_REV)
'   * up to 32px wide
    if ( (ch < font.char_min) or (ch > font.char_max) ) ' don't waste any time if the char is invalid
        return

    bpr := font.glyph_w/8                         ' calc number of bytes per glyph row
    lastbyte := bpr-1
    p := font.p_ftable + ( (ch-font.char_min) * (font.glyph_h * bpr))
    last_glcol := font.glyph_w-1                  ' last column of pixels in font
    last_glrow := font.glyph_h-1                 '   definition
    char_wid := font.cell_w * font.xscale         ' scaled character dimensions
    char_ht := font.cell_h * font.yscale          '

    if ( _char_attrs & TERMINAL )
        { process control characters, don't draw them }
        case ch
            LF:
                { line feed }
                font.cursor_ymax += char_ht            ' goto next text row
                if ( font.cursor_ymax > font.cursor_ymax )
                    font.cursor_ymax -= char_ht        ' scroll the display up a row if we try to go
#ifndef GFX_DIRECT
                    scroll_up_fs(char_ht)       '   past the end
#endif
                return
            CR:
                { carriage return }
                cursor.x := 0                  ' goto first text column
                return

    { read a glyph in from the font table }
    repeat gl_row from 0 to last_glrow          ' for each glyph row
        gl_col := 0
        repeat rowbyte from 0 to lastbyte       ' for each byte in the row
            repeat bit from 0 to 7
                { normal byte-order glyphs (MSBit in each byte of glyph data is left edge) }
                if ( byte[p][rowbyte] & (1 << bit) )
                    plot(   cursor.x + gl_col, ...
                            cursor.y + gl_row, ...
                            ctx.fgcolor )
                else
                    { draw the background color for unset pixels if the DRAWBG attribute is set
                        ( see char_attr() )
                    otherwise, unset pixels will be ignored (effectively transparent) }
                    if ( _char_attrs & DRAWBG )
                        plot(   cursor.x + gl_col, ...
                                font.cursor_ymax + gl_row, ...
                                ctx.bgcolor )
                gl_col++
        p += bpr                                ' point to next row of glyph data

    cursor.x += char_wid                       ' goto next column

    if ( cursor.x > font.cursor_xmax )
        cursor.x := 0                          ' goto the first column of the next row if we try
        cursor.y += char_ht                    '   to go past the right edge
    if ( cursor.y > font.cursor_ymax )
        cursor.y -= char_ht                    ' scroll the display up a row if we try to go
# ifndef GFX_DIRECT
        scroll_up_fs(char_ht)                   '   past the end
# endif


PUB putchar_90deg(ch) | glyph_col, glyph_row, xs, ys, xe, ye, last_glyph_col, last_glyph_row, glyph, char_ht, char_wid
' Low-level character rendering routine
'   For font file definitions with these characteristics:
'   * 90 degrees rotation (landscape)
'   * each glyph word is a column of the glyph, e.g. for 5x8 'A':
'       %01111100
'       %00010010
'       %00010001
'       %00010010
'       %01111100
'   * byte order can be normal (leftmost bytes first)
'       or reversed (rightmost bytes first)
    if ( (ch < font.char_min) or (ch > font.char_max) ) ' don't waste any time if the char is invalid
        return

    last_glyph_col := font.glyph_w-1              ' last column of pixels in font
    last_glyph_row := font.glyph_h-1             '   definition
    char_wid := font.cell_w * font.xscale         ' scaled character dimensions
    char_ht := font.cell_h * font.yscale          '

    if ( _char_attrs & TERMINAL )
        { process control characters, don't draw them }
        case ch
            LF:
                { line feed }
                cursor.y += char_ht            ' goto next text row
                if ( cursor.y > font.cursor_ymax )
                    cursor.y -= char_ht        ' scroll the display up a row if we try to go
#ifndef GFX_DIRECT
                    scroll_up_fs(char_ht)       '   past the end
#endif
                return
            CR:
                { carriage return }
                cursor.x := 0                  ' goto first text column
                return

    { read a glyph in from the font table }
    ch *= font.glyph_w
    if ( (font.xscale == 1) and (font.yscale == 1) )
        { no scaling; render font 1:1 }
        repeat glyph_col from 0 to last_glyph_col
#ifdef FNT_GLYPH_REV
            { reversed byte order fonts }
            xs := cursor.x + (font.glyph_w-glyph_col)
#else
            { normal byte order fonts }
            xs := cursor.x + glyph_col
#endif
            glyph := ch + glyph_col             ' point to current glyph data
            repeat glyph_row from 0 to last_glyph_row
                if ( byte[font.p_ftable][glyph] & (1 << glyph_row) )
                    plot(   xs, ...
                            cursor.y + glyph_row, ...
                            ctx.fgcolor )
                else
                    if ( _char_attrs & DRAWBG )
                        { actually draw the currently set background color (see bgcolor() ) }
                        { NOTE: This incurs a significant speed penalty if enabled }
                        plot(   xs, ...
                                cursor.y + glyph_row, ...
                                ctx.bgcolor )
    else
        { scale font rendering up by an integer factor (x, y independently) }
        { use filled boxes to draw each pixel of the glyph }
        repeat glyph_col from 0 to last_glyph_col
            { normal byte order fonts }
            xs := cursor.x + (glyph_col * font.xscale)
            xe := (xs + font.xscale)
            glyph := ch + glyph_col             ' point to current glyph data
            repeat glyph_row from 0 to last_glyph_row
                ys := cursor.y + (glyph_row * font.yscale)
                ye := ys + font.yscale
                if ( byte[font.p_ftable][glyph] & (1 << glyph_row) )
                    box(xs, ys, xe, ye, ctx.fgcolor, true)
                else
                    if ( _char_attrs & DRAWBG )
                        box(xs, ys, xe, ye, ctx.bgcolor, true)

    cursor.x += char_wid                       ' goto next column
    if ( cursor.x > font.cursor_xmax )
        cursor.x := 0                          ' goto the first column of the next row if we try
        cursor.y += char_ht                    '   to go past the right edge
    if ( cursor.y > font.cursor_ymax )
        cursor.y -= char_ht                    ' scroll the display up a row if we try to go
# ifndef GFX_DIRECT
        scroll_up_fs(char_ht)                   '   past the end
# endif


CON

    { character attributes }
    DRAWBG      = (1 << 0)                      ' draw background color
    TERMINAL    = (1 << 1)                      ' process control characters
    TEXT_WRAP   = (1 << 2)                      ' wrap text when crossing display bounds

PUB charattrs = char_attrs
PUB char_attrs(attrs)
' Set character attributes
    _char_attrs := attrs


PUB circle(cx, cy, r, c, f=false) | x, y, err, cdx, cdy, cht, rsq
' Draw a circle
'   cx, cy: center coordinates
'   r:      circle radius
'   c:      color to draw circle
'   f:      fill the circle (0: no, nonzero: yes; default: no)
    if ( f )                                    ' fill
        rsq := (r * r)                          ' pre-calc radius^2
        repeat x from -r to r
            cht := sqrt( rsq - (x * x) )
            repeat y from -cht to cht-1
                plot(cx + x, cy + y, c)
    else                                        ' no fill
        x := r - 1
        y := 0
        cdx := 1
        cdy := 1
        err := cdx - (r << 1)

        repeat while (x >= y)
            plot(cx + x, cy + y, c)
            plot(cx + y, cy + x, c)
            plot(cx - y, cy + x, c)
            plot(cx - x, cy + y, c)
            plot(cx - x, cy - y, c)
            plot(cx - y, cy - x, c)
            plot(cx + y, cy - x, c)
            plot(cx + x, cy - y, c)

            if (err <= 0)
                y++
                err += cdy
                cdy += 2

            if (err > 0)
                x--
                cdx += 2
                err += cdx - (r << 1)

#ifndef GFX_DIRECT
PUB copy(sx, sy, ex, ey, dx, dy) | x, y, tmp
' Copy rectangular region at (sx, sy, ex, ey) to (dx, dy)
    repeat y from sy to ey
        repeat x from sx to ex
            tmp := point(x, y)
            plot((dx + x)-sx, (dy + y)-sy, tmp)


PUB cut(sx, sy, ex, ey, dx, dy) | x, y, tmp
' Copy rectangular region at (sx, sy, ex, ey) to (dx, dy)
'   Subsequently clears original region (sx, sy, ex, ey) to background color
    repeat y from sy to ey
        repeat x from sx to ex
            tmp := point(x, y)
            plot((dx + x)-sx, (dy + y)-sy, tmp)             ' Copy to destination region
            plot(x, y, ctx.bgcolor)                            ' Cut the original region
#endif


PUB fgcolor(col)
' Set foreground color of subsequent drawing operations
    ctx.fgcolor := col


PUB fontheight = font_height
PUB font_height(): curr_ht
' Return the set font height
    return font.glyph_h


PUB fontscale = font_scl
PUB font_scl(x, y): curr_scl
' Set font rendering scale factor
'   Valid values: 1..8
    font.xscale := 1 #> x <# 8
    font.yscale := 1 #> y <# 8


PUB fontsize = font_sz
PUB font_sz(w=0, h=0)
' Set expected dimensions of font glyphs
'   w, h:   dimensions (optional; if unspecified, the last set values will be used to
'               recompute cursor limits)
'   NOTE: This has a direct impact on the number of text columns and rows
'   NOTE: font_spacing() should be called before calling this method
    font.glyph_w := w
    font.glyph_h := h
    font.xscale := 1 #> font.xscale
    font.yscale := 1 #> font.yscale

    font.cell_w := (font.glyph_w + font.hspace)     ' calc overall character cell
    font.cell_h := (font.glyph_h + font.vspace)     '   dims (font size + spacing)
    font.cursor_xmax := (ctx.ex - font.cell_w)  ' calc maximum x, y character
    font.cursor_ymax := (ctx.ey - font.cell_h) '   pixel position
    font.cell_xmax := ( (ctx.ex-ctx.sx+1) / font.cell_w)-1   '   and character-cell position
    font.cell_ymax := ( (ctx.ey-ctx.sy+1) / font.cell_h)-1


PUB fontspacing = font_spacing
PUB font_spacing(h, v)
' Set spacing between character cells (horizontally, vertically)
    font.hspace := h
    font.vspace := v


PUB fontwidth = font_width
PUB font_width(): curr_wid
' Return the set font width
    return font.glyph_w


PUB get_address(): addr
' Get the currently set display buffer address
    return ctx.p_buffer


#ifndef HAS_HLINE
PUB hline(y, xs, len, c) | x
' Draw horizontal line
'   y:      y-position (pixels)
'   xs:     x start-position (pixels)
'   len:    length of line (pixels)
'   c:      color
'# ifndef GFX_DIRECT
    memfill(xs, y, c, len)
'# else
'    repeat x from xs to (xs+len-1)
'        plot(x, y, c)
'# endif
#endif


#ifndef GFX_DIRECT
PUB line(x1, y1, x2, y2, c) | sx, sy, ddx, ddy, err, e2
' Draw line from x1, y1 to x2, y2, in color c
    if (x1 == x2) or (y1 == y2)
        if (x1 == x2)                           ' draw vertical line
            repeat sy from y1 to y2
                plot(x1, sy, c)
        if (y1 == y2)                           ' draw horizontal line
            repeat sx from x1 to x2
                plot(sx, y1, c)
    else                                        ' draw diag. line (Bresenham)
        ddx := abs(x2-x1)
        ddy := abs(y2-y1)
        err := ddx-ddy

        sx := -1
        if (x1 < x2)
            sx := 1

        sy := -1
        if (y1 < y2)
            sy := 1

        repeat until ((x1 == x2) AND (y1 == y2))
            plot(x1, y1, c)
            e2 := err << 1

            if e2 > -ddy
                err -= ddy
                x1 += sx

            if e2 < ddx
                err += ddx
                y1 += sy
#endif


PUB position = pos_xy
PUB pos_xy(x, y)
' Set text draw position, in character-cell col and row
    cursor.x := x                              ' leave untouched; plot() will validate whether
    cursor.y := y                              '   any pixels are offscreen


PUB r5g6b5_rgb565(r, g, b): rgb565
' Return 16-bit color in RGB565 format, given red (5), green (6), blue (5) components
    return ((r << 11) | (g << 5) | b)


PUB rgbw8888_rgb32(r, g, b, w): rgb32
' Return 32-bit long from discrete Red, Green, Blue, White color components (values 0..255)
    rgb32.byte[3] := r
    rgb32.byte[2] := g
    rgb32.byte[1] := b
    rgb32.byte[0] := w


PUB rgbw8888_rgb32_brightness(r, g, b, w, level): rgb32
' Return 32-bit long from discrete Red, Green, Blue, White color components
'   and clamp all color channels to maximum level or brightness
'   Valid values:
'       r, g, b, w: 0..255
'       level: 0..100 (%)
    if (level <= 0)
        return 0
    elseif (level >= 255)
        return RGBW8888_RGB32(r, g, b, w)
    else
        r := r * level / 255                    ' Apply level to RGBW
        g := g * level / 255
        b := b * level / 255
        w := w * level / 255
        return RGBW8888_RGB32(r, g, b, w)


pub rgb32_rgb16(rgb32): rgb16
' Convert RGBx32 (8-8-8-x) color to RGB16 (5-6-5)
'   rgb32:      RGBx32 color (RGB left-justified, x is don't care)
'   Returns:    RGB565 color
    asm
        mov     rgb16, rgb32
        rgbsqz  rgb16                           ' keep top 5 bits red, 6 bits green, 5 bits blue
    endasm                                      '   and shift them down to the lower 16 bits


PUB rgb565_r5(rgb565): r5
' Isolate 5-bit red component of 16-bit RGB565 color
    return ((rgb565 & $F800) >> 11)


PUB rgb565_g5(rgb565): g5
' Isolate 6-bit green component of 16-bit RGB565 color
    return ((rgb565 & $07E0) >> 5)


PUB rgb565_b5(rgb565): b5
' Isolate 5-bit blue component of 16-bit RGB565 color
    return (rgb565 & $001F)


PUB rgb565_r8(rgb565): r8
' Isolate red component of 16-bit RGB565 color and return value scaled to 8-bit range
    return (((rgb565 & $F800) >> 11) * 527 + 23 ) >> 6


PUB rgb565_g8(rgb565): g8
' Isolate green component of 16-bit RGB565 color and return value scaled to 8-bit range
    return (((rgb565 & $7E0) >> 5)  * 259 + 33 ) >> 6


PUB rgb565_b8(rgb565): b8
' Isolate blue component of 16-bit RGB565 color and return value scaled to 8-bit range
    return ((rgb565 & $1F) * 527 + 23 ) >> 6


#ifndef GFX_DIRECT
PUB scale(sx, sy, ex, ey, offsx, offsy, size) | x, y, dx, dy, in
' Scale a region of the display up by size
    repeat y from sy to ey
        repeat x from sx to ex
            in := point(x, y)
            dx := offsx + (x*size)-(sx*size)
            dy := offsy + (y*size)-(sy*size)
            box(dx, dy, dx + size, dy + size, in, true)
#endif


#ifndef GFX_DIRECT
PUB scrolldown = scroll_down
PUB scroll_down(sx, sy, ex, ey) | scr_width, src, dest, x, y, cw
' Scroll a region of the display down by 1 pixel
    scr_width := ex-sx
    cw := ctx.ex-ctx.sx
    repeat y from ey-1 to sy
#ifdef 1BPP
        ' use Copy() for monochrome display types, until a more efficient
        '   method can be devised
        copy(sx, y, ex, y, sx, y+1)
#elseifdef SCROLL_USES_COPY
        copy(sx, y, ex, y, sx, y+1)
#else
        src := sx + (y * cw) * BYTESPERPX
        dest := sx + ((y+1) * cw) * BYTESPERPX
        MEMMV_NATIVE(ctx.p_buffer + dest, ctx.p_buffer + src, scr_width)
#endif


#ifndef GFX_DIRECT
PUB scroll_down_fs(px) | max_pg, y, x, fb_off, cw, ch
' Scroll down full screen (1bpp displays only)
'   px: number of rows or lines to scroll
    cw := ctx.ex-ctx.sx
    ch := ctx.ey-ctx.sy
#ifdef 1BPP
    px := px <# cy                    ' clamp scroll length to display height
    max_pg := (cy / 8)                ' get # of pages from set display height
    repeat px
        repeat y from max_pg to 0               ' bottom-up so it doesn't look strange
            fb_off := (y * cw)
            repeat x from 0 to ctx.ex
                { scroll down a page of display memory (lsh), then put the bottom-most pixel of the
                    previous page into the top-most pixel of this one }
                byte[ctx.p_buffer][fb_off + x] <<= 1
                if ( y > 0 )
                    { don't try to copy pixels from before the first page }
                    byte[ctx.p_buffer][fb_off + x] |= (byte[ctx.p_buffer] ...
                                                         [((y-1) * cw) + x ] >> 7) & 1
#else
    repeat px
        scroll_down(0, 0, ctx.ex, ctx.ey)
#endif
#endif


PUB scrollleft = scroll_left
PUB scroll_left(sx, sy, ex, ey) | scr_width, src, dest, y, yoffs, cw
' Scroll a region of the display left by 1 pixel
    scr_width := ex-sx
    cw := ctx.ex-ctx.ey
    repeat y from sy to ey
#ifdef 1BPP
        copy(sx, y, ex, y, sx-1, y)
#elseifdef SCROLL_USES_COPY
        copy(sx, y, ex, y, sx-1, y)
#else
        yoffs := (y * cw)
        src := (sx + yoffs) * BYTESPERPX
        dest := ((0 #> (sx-1)) + yoffs) * BYTESPERPX
        MEMMV_NATIVE(ctx.p_buffer+dest, ctx.p_buffer+src, scr_width)
#endif


PUB scrollright = scroll_right
PUB scroll_right(sx, sy, ex, ey) | scr_width, src, dest, y, yoffs, cw
' Scroll a region of the display right by 1 pixel
    scr_width := ex-sx
    cw := ctx.ex-ctx.ey
    repeat y from sy to ey
#ifdef 1BPP
        copy(sx, y, ex, y, sx+1, y)
#elseifdef SCROLL_USES_COPY
        copy(sx, y, ex, y, sx+1, y)
#else
        yoffs := (y * cw)
        src := (sx + yoffs) * BYTESPERPX
        dest := (((sx+1) <# cw) + yoffs) * BYTESPERPX
        MEMMV_NATIVE(ctx.p_buffer + dest, ctx.p_buffer + src, scr_width)
#endif


PUB scrollup = scroll_up
PUB scroll_up(sx, sy, ex, ey) | sw, y, s, d, p, bpl
' Scroll a region of the display up by 1 pixel
'   sx, sy:     upper-left coordinates of scroll area (must be less than (ex, ey) )
'   ex, ey:     lower-right coordinates of scroll area (must be greater than (sx, sy) )

    ' reject bad coordinates
    if (    (sx < 0) or (sx > ctx.ex) or (sy < 0) or (sy > ctx.ey) or ...
            (ex < 0) or (ex > ctx.ex) or (ey < 0) or (ey > ctx.ey) )
        return
# ifdef 1BPP
        copy(sx, y, ex, y, sx, y-1)
# else
    ' prep, pre-calc
    p := ctx.p_buffer
    sw := ( ( (ex-sx)+1) * BYTESPERPX) / BPPDIV ' get scroll width in _bytes_
    sx := (sx * BYTESPERPX) / BPPDIV            ' scale left X coord by display color depth
    bpl := ctx.stride

    repeat y from sy+1 to ey
        s := sx + (y * bpl)                     ' source: sx, sy
        d := sx + ((y-1) * bpl)                 ' destination: the line above

        ' do the actual scrolling:
        ' pick the fastest possible block move function, based on whether the scroll width is
        '   evenly divisible by 4, 2, or 1
        ifnot ( sw & %11 )
            longmove(p+d, p+s, sw >> 2)         ' bytes / 4
        elseifnot ( sw & %1 )
            wordmove(p+d, p+s, sw >> 1)         ' bytes / 2
        else
            bytemove(p+d, p+s, sw)

    line(sx, ey, ex, ey, ctx.bgcolor)              ' erase the line at the bottom of the scroll area
# endif
#endif


#ifndef GFX_DIRECT
PUB scroll_up_fs(px) | max_pg, y, x, fb_off, w, ch
' Scroll up full screen
'   px: number of rows or lines to scroll
    ch := ctx.ey-ctx.sy
#ifdef 1BPP
    px := px <# ch                    ' clamp scroll length to display height
    max_pg := (ch / 8)                ' get # of pages from set display height
    w := (ctx.ex-ctx.sx)+1
    repeat px
        repeat y from 0 to max_pg
            fb_off := (y * w)
            repeat x from 0 to ctx.ex
                { scroll up a page of display memory (rsh), then put the top-most pixel of the next
                    page into the bottom-most pixel of this one }
                byte[ctx.p_buffer][fb_off + x] >>= 1
                if ( y < max_pg )
                    byte[ctx.p_buffer][fb_off + x] |= (byte[ctx.p_buffer] ...
                                                         [((y+1) * w) + x] & 1) << 7
#else
    repeat px                                   '   scroll up one text row
        scrollup(0, 0, ctx.ex, ctx.ey)
#endif
#endif


PUB address = set_address
PUB set_address(addr=0)
' Set context/display buffer address
'   addr: address of display buffer to use (or 0 to use the driver's internal buffer)
#ifndef GFX_DIRECT
    { only build this if targetting a buffered display; the framebuffer won't exist otherwise }
    if ( addr == 0 )
        { use the buffer built-in to the display driver }
        screen.p_buffer := @_framebuffer
        ctx.p_buffer := @_framebuffer
    else
        { use an external buffer }
        screen.p_buffer := addr
        ctx.p_buffer := addr
#endif


pub set_context_area(sx, sy, ex, ey)
' Define a graphics context's screen area

    ' swap coordinates if the ending set is less than the starting set
    if ( ex < sx )
        sx, ex := ex, sx
    if ( ey < sy )
        sy, ey := ey, sy

    ctx.sx := 0 #> sx
    ctx.sy := 0 #> sy
    ctx.ex := ex <# (screen.width-1)
    ctx.ey := ey <# (screen.height-1)

    DEBUG("[gfx] set_context_area(", udec_(ctx.sx), udec_(ctx.sy), udec_(ctx.ex), udec_(ctx.ey), ")")

    ' set up the context's pointer as an offset from the screen's base
    ctx.stride := screen.stride
    ctx.p_buffer := screen.p_buffer + ( (sx * BYTESPERPX) + (sy * screen.stride) )
    ctx.buffer_sz := ( (ctx.ey-ctx.sy)+1) * ctx.stride


pub set_context_dims(w, h)
' Set or resize a graphics context (origin coordinates are not changed)
    ctx.ex := (ctx.sx+w-1) <# (screen.width-1)
    ctx.ey := (ctx.sy+h-1) <# (screen.height-1)

    ctx.stride := screen.stride
    ctx.buffer_sz := ( (ctx.ey-ctx.sy)+1) * ctx.stride


pub set_display_dims(w, h)

    screen.width := w
    screen.height := h
    screen.stride := (w * BYTESPERPX) / BPPDIV
    screen.buffer_sz := h * screen.stride


PUB set_font(ptr_fnt, ptr_setup)
' Setup the font and character routines
'   ptr_fnt: pointer to the font glyph table (the font bitmaps)
'   ptr_setup: pointer to 7-byte structure containing font characteristics:
'       byte[ptr_setup][0]: font width
'       byte[ptr_setup][1]: font height
'       byte[ptr_setup][2]: font rotation
'       byte[ptr_setup][3]: font first character
'       byte[ptr_setup][4]: font last character
'       byte[ptr_setup][5]: font space between chars (horiz.)
'       byte[ptr_setup][6]: font space between chars (vert.)
    set_font_addr(ptr_fnt)
'    bytemove(@font.glyph_w, ptr_setup, 7)
    font.glyph_w := byte[ptr_setup][0]
    font.glyph_h := byte[ptr_setup][1]
    font.rotation := byte[ptr_setup][2]
    font.char_min := byte[ptr_setup][3]
    font.char_max := byte[ptr_setup][4]
    font.hspace := byte[ptr_setup][5]
    font.vspace := byte[ptr_setup][6]

    { set up size, spacing }
    font_sz( byte[ptr_setup][0], byte[ptr_setup][1] )

    { check rotation }
    if ( byte[ptr_setup][2] == 0 )
'        set_font_rotation_0deg()
    elseif ( byte[ptr_setup][2] == 90 )
        set_font_rotation_90deg()


PUB set_font_addr(addr)
' Set address of font definition
    font.p_ftable := addr


PUB set_font_char_range(cmin, cmax)
' Set range of ASCII values contained in font
    font.char_min := cmin
    font.char_max := cmax


'PUB set_font_rotation_0deg()
' Set putchar function to 0-degree rotated type
'    putchar := @putchar_0deg


PUB set_font_rotation_90deg()
' Set putchar function to 90-degree rotated type
    putchar := @putchar_90deg


PUB set_putchar(ptr)
' Set a custom putchar function
    putchar := ptr


PUB set_rotation(r) | w, h
' Set display orientation (soft-rotation)                                                               
'   r:  orientation from hardware default (degrees)
'       0:      no change from panel/hardware default
'       90:     rotate 90deg CW
'       180:    rotate 180deg
'       270:    rotate 270deg

    case r
        0:
            w := WIDTH                          ' orientation = panel orientation
            h := HEIGHT
            ctx.rotation := 0
        90:
            w := HEIGHT                         ' orientation width/height swapped
            h := WIDTH
            ctx.rotation := 1
        180:
            w := WIDTH                          ' panel width/height unchanged
            h := HEIGHT
            ctx.rotation := 2
        270:
            w := HEIGHT                         ' panel width/height swapped
            h := WIDTH
            ctx.rotation := 3
        other:
            return

    set_display_dims(w, h)                              ' set/update drawable screen dimensions
    set_context_dims(w, h)
    font_sz()                                   ' re-compute text cursor limits


pub str_width(p_str): w

    return strsize(p_str) * (font.glyph_w+font.hspace)


PUB textcols = text_cols
PUB text_cols(): cols
' Returns number of displayable text columns, based on set display width, font width, and scale
    return font.cell_xmax / font.xscale

PUB textrows = text_rows
PUB text_rows(): rows
' Returns number of displayable text rows, based on set display height, font height, and scale
    return font.cell_ymax / font.yscale


#ifndef HAS_VLINE
pub vline(x, ys, len, c) | y
' Draw horizontal line
'   x:      x-position (pixels)
'   ys:     y start-position (pixels)
'   len:    length of line (pixels)
'   c:      color
    repeat y from ys to (ys+len-1)
        plot(x, y, c)
#endif


